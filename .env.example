VITE_DEEPSEEK_API_KEY=your_deepseek_key
VITE_DEEPSEEK_MODEL=deepseek-chat

API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=huishi_classroom

# 管理员上传模型的服务端持久化目录；容器部署时请指向持久卷。
RESOURCE_MODEL_STORAGE_DIR=./server/storage/resource-models

# 内置模型默认由本站 /models/ 提供，并由浏览器本地缓存。保持为空，不使用 COS/CDN。
VITE_MODEL_COS_BASE_URL=

# Used only to create the first admin when no admin exists in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# 本地流式中文语音识别（sherpa-onnx）
ASR_ENABLED=true
ASR_MODEL_DIR=./models/asr/sherpa-onnx-streaming-paraformer-bilingual-zh-en
ASR_MAX_SESSIONS=3
ASR_NUM_THREADS=1
ASR_ENDPOINT_SILENCE_SECONDS=1.0

# 豆包语音合成服务配置
VOLC_TTS_API_KEY=你的API密钥
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_DEFAULT_SPEAKER=你的音色ID
VOLC_TTS_SPEAKERS=你的音色ID

# 自研 3D 建模生成服务
AI3D_SECRET_ID=
AI3D_SECRET_KEY=
AI3D_REGION=ap-guangzhou
